NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=

RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────
# Secret key + webhook signing secret (Dashboard → Developers).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_...) from the Stripe Dashboard. Each surface is
# feature-flagged on its env: absent → the UI falls back to the
# mailto flow for that SKU, present → self-serve Stripe Checkout.
# See docs/stripe-billing-setup.md for the exact Products/Prices
# to create.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_BASIC_MONTHLY=
STRIPE_PRICE_ID_PACK_SMALL=
STRIPE_PRICE_ID_PACK_MEDIUM=
STRIPE_PRICE_ID_PACK_LARGE=

# ── RevenueCat (mobile IAP) ───────────────────────────────────────
# Authorization header value for the webhook receiver at
# /api/webhooks/revenuecat. Generate any long random string, paste it
# here AND in RevenueCat → Project → Integrations → Webhooks.
# Missing value = the endpoint hard-fails (500), never accepts
# unsigned events.
REVENUECAT_WEBHOOK_SECRET=set-from-revenuecat-dashboard
